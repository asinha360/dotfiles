# Rendered by wallsync. cava reads it as ~/.config/cava/themes/wallsync
# (symlink to this file) and re-reads it on SIGUSR2.
# Vertical gradient from bottom (dim) to top (hi); background stays default
# so Ghostty's translucent panel shows through. cava 1.0.0 counts at most 7
# gradient colours.
[color]
gradient = 1
gradient_color_1 = '{{dim_hex}}'
gradient_color_2 = '{{sub_hex}}'
gradient_color_3 = '{{fg_hex}}'
gradient_color_4 = '{{hi_hex}}'
